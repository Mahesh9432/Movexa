APP_NAME=Movexa API
APP_VERSION=1.0.0
# Runtime database URL. For Supabase, use the pooled connection string.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/movexa
# Direct (non-pooled) URL used by Alembic migrations. For Supabase, use the direct connection string.
MIGRATION_DATABASE_URL=
SECRET_KEY=movexa-dev-secret-change-me
